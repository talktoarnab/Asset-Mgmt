{
  "name": "@shelfkit/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Lambda handlers for the Micro-Library & Asset Checkout Suite",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/local/server.ts",
    "seed": "tsx src/local/setup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.16.5",
    "esbuild": "^0.23.1",
    "eslint": "^9.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  }
}
